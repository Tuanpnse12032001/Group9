<h2>Quên mật khẩu</h2>

<div class="card">
    <p>Nhập email tài khoản của bạn để đặt lại mật khẩu.</p>

    <label>Email</label>
    <input type="email" id="email" placeholder="Nhập email của bạn" />

    <button onclick="forgotPassword()">Tiếp tục</button>

    <div id="message"></div>
</div>

@section Scripts {
    <script>
        requireGuestPage();

        async function forgotPassword() {
            const email = document.getElementById("email").value.trim();

            if (!email) {
                showSuccess("Vui lòng nhập email.");
                return;
            }

            const result = await apiPost("/api/auth/forgot-password", {
                email
            });

            if (!result.ok) {
                showMessage(result);
                return;
            }

            const token =
                result.data.resetPasswordToken ||
                result.data.resetToken ||
                result.data.token ||
                "";

            if (!token) {
                showSuccess("Yêu cầu đặt lại mật khẩu thành công. Vui lòng kiểm tra email nếu hệ thống có gửi email.");
                return;
            }

            sessionStorage.setItem("resetPasswordEmail", email);
            sessionStorage.setItem("resetPasswordToken", token);

            showSuccess("Xác thực email thành công. Đang chuyển sang trang đặt lại mật khẩu...");

            setTimeout(() => {
                window.location.href = "/auth-ui/reset-password";
            }, 800);
        }
    </script>
}